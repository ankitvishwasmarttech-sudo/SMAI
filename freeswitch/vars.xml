<include>
  <!-- Replace YOUR_PUBLIC_IP with your server IP -->
  <X-PRE-PROCESS cmd="set" data="domain=YOUR_PUBLIC_IP"/>
  <X-PRE-PROCESS cmd="set" data="domain_name=$${domain}"/>
  <X-PRE-PROCESS cmd="set" data="external_sip_ip=YOUR_PUBLIC_IP"/>
  <X-PRE-PROCESS cmd="set" data="external_rtp_ip=YOUR_PUBLIC_IP"/>
  <X-PRE-PROCESS cmd="set" data="bind_server_ip=auto"/>

  <!-- Codec preferences -->
  <X-PRE-PROCESS cmd="set" data="global_codec_prefs=PCMU,PCMA,G729"/>
  <X-PRE-PROCESS cmd="set" data="outbound_codec_prefs=PCMU,PCMA"/>

  <!-- AI Bridge -->
  <X-PRE-PROCESS cmd="set" data="ai_bridge_host=127.0.0.1"/>
  <X-PRE-PROCESS cmd="set" data="ai_bridge_port=5000"/>

  <!-- Default caller ID -->
  <X-PRE-PROCESS cmd="set" data="default_caller_id_name=SmartTech"/>
  <X-PRE-PROCESS cmd="set" data="default_caller_id_number=+91XXXXXXXXXX"/>

  <!-- Hold music -->
  <X-PRE-PROCESS cmd="set" data="hold_music=local_stream://moh"/>

  <!-- Tones -->
  <X-PRE-PROCESS cmd="set" data="indian_ringback_tone=%(400,200,400),(400,200,400),(0,2000,0);loops=-1"/>
</include>
