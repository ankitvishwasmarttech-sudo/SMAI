<include>
  <context name="default">

    <!-- ── Inbound DID: route to AI bridge ──────────────────────────── -->
    <extension name="ai_inbound">
      <condition field="destination_number" expression="^(\+?91\d{10}|1000)$">
        <action application="log"         data="INFO AI_BRIDGE: Inbound call to $1"/>
        <action application="answer"/>
        <action application="sleep"       data="500"/>
        <action application="set"         data="RECORD_STEREO=true"/>
        <action application="set"         data="record_sample_rate=16000"/>
        <action application="set"         data="session_in_hangup_hook=true"/>
        <action application="set"         data="hangup_after_bridge=true"/>
        <!-- Route to Python bridge via ESL socket -->
        <action application="socket"      data="${ai_bridge_host}:${ai_bridge_port} async full"/>
      </condition>
    </extension>

    <!-- ── Live agent queue (transfer destination) ──────────────────── -->
    <extension name="live_agent">
      <condition field="destination_number" expression="^9000$">
        <action application="log"         data="INFO Transfer to live agent"/>
        <action application="set"         data="ringback=${indian_ringback_tone}"/>
        <action application="bridge"      data="user/agent1@${domain}"/>
      </condition>
    </extension>

    <!-- ── IVR menu (optional) ──────────────────────────────────────── -->
    <extension name="ivr_menu">
      <condition field="destination_number" expression="^8000$">
        <action application="answer"/>
        <action application="sleep"       data="1000"/>
        <action application="ivr"         data="main_ivr"/>
      </condition>
    </extension>

    <!-- ── Echo test ──────────────────────────────────────────────────── -->
    <extension name="echo">
      <condition field="destination_number" expression="^9196$">
        <action application="answer"/>
        <action application="echo"/>
      </condition>
    </extension>

    <!-- ── Hangup on unmatched ──────────────────────────────────────── -->
    <extension name="catch_all">
      <condition field="destination_number" expression=".*">
        <action application="log"         data="WARNING Unmatched: ${destination_number}"/>
        <action application="hangup"      data="UNALLOCATED_NUMBER"/>
      </condition>
    </extension>

  </context>
</include>
