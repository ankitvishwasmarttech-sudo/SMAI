# ─── Server
SERVER_IP=YOUR_PUBLIC_IP
DOMAIN=YOUR_PUBLIC_IP

# ─── SIP Trunk
SIP_TRUNK_USER=your_sip_user
SIP_TRUNK_PASS=your_sip_pass
SIP_TRUNK_HOST=sip.yourprovider.com
DID_NUMBER=+91XXXXXXXXXX

# ─── AI Provider
AI_PROVIDER=openai
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=
GROQ_API_KEY=

# ─── OpenAI Realtime
OPENAI_MODEL=gpt-4o-realtime-preview-2024-12-17
AI_VOICE=alloy
VAD_SILENCE_MS=600
VAD_THRESHOLD=0.5

# ─── ESL / Bridge
ESL_HOST=127.0.0.1
ESL_PORT=8021
ESL_PASSWORD=ClueCon
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5000

# ─── n8n
N8N_PORT=3000
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_strong
N8N_WEBHOOK_URL=http://127.0.0.1:3000/webhook

# ─── CRM
CRM_WEBHOOK_INTERESTED=https://hooks.zapier.com/...
CRM_WEBHOOK_NOT_INTERESTED=https://hooks.zapier.com/...

# ─── Monitoring
GRAFANA_ADMIN_PASSWORD=changeme
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ─── Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
