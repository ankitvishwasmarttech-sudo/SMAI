# ─── Server ──────────────────────────────────────────
SERVER_IP=YOUR_PUBLIC_IP
DOMAIN=YOUR_PUBLIC_IP

# ─── SIP Trunk ───────────────────────────────────────
SIP_TRUNK_USER=your_sip_user
SIP_TRUNK_PASS=your_sip_pass
SIP_TRUNK_HOST=sip.yourprovider.com
DID_NUMBER=+91XXXXXXXXXX

# ─── AI Provider ─────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-realtime-preview-2024-12-17
AI_VOICE=alloy
VAD_SILENCE_MS=600
VAD_THRESHOLD=0.5

# ─── ESL / Bridge ────────────────────────────────────
ESL_HOST=127.0.0.1
ESL_PORT=8021
# Fix #6: Change this — never keep default ClueCon on production
ESL_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=5000

# ─── Agent fallback (Fix #9) ─────────────────────────
AGENT_EXTENSION=9000

# ─── n8n ─────────────────────────────────────────────
N8N_PORT=3000
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
N8N_WEBHOOK_URL=http://127.0.0.1:3000/webhook

# ─── Monitoring ──────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ─── Redis ───────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
